POST http://localhost:8081/api/v1/auth/register
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="data"
Content-Type: application/json

{
  "email": "nibavsss@mail.ru",
  "password": "pass1234",
  "merchantName": "Nibavss",
  "merchantCategory": "Clothes",
  "country": "RUS",
  "phoneNumber": "+79998887764",
  "preferableNotificationChannel": "EMAIL"
}

--MyBoundary
Content-Disposition: form-data; name="photo"; filename="avatar.jpeg"
Content-Type: image/jpeg

< ./avatar.jpeg
--MyBoundary--

